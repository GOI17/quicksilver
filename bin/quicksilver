#!/bin/bash
set -euo pipefail

# Follow Homebrew's bin symlink to the configuration inside the keg.
script_path="${BASH_SOURCE[0]}"
while [ -L "$script_path" ]; do
  script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
  script_path="$(readlink "$script_path")"
  case "$script_path" in
    /*) ;;
    *) script_path="$script_dir/$script_path" ;;
  esac
done
script_dir="$(cd -- "$(dirname -- "$script_path")" && pwd)"
QUICKSILVER_CONFIG_DIR="$(cd -- "$script_dir/.." && pwd)"
export QUICKSILVER_CONFIG_DIR
export NVIM_APPNAME=quicksilver

if [ "${1:-}" = "--version" ]; then
  printf 'Quicksilver v%s\n' "$(cat "$QUICKSILVER_CONFIG_DIR/VERSION")"
  exit 0
fi

exec nvim -u "$QUICKSILVER_CONFIG_DIR/init.lua" "$@"
